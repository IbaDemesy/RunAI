# H Company Agents API key (h/web-surfer-pro sessions and Holo chat).
HAI_API_KEY=
# Optional second H organization key, pooled with HAI_API_KEY for more concurrent sessions.
HAI_API_KEY_2=
# Gladia speech-to-text key (live voice input).
GLADIA_API_KEY=
# Optional backup Gladia key.
GLADIA_API_KEY_2=
# Linkup search key (race lookup and start-URL precomputation).
LINKUP_API_KEY=
# Optional backup Linkup key.
LINKUP_API_KEY_2=
# App mode: live, demo or replay (defaults to live).
RUNAI_MODE=
# Set to 1 when the app is publicly reachable; live mode then requires RUNAI_BASIC_AUTH.
RUNAI_PUBLIC=
# HTTP Basic credentials in user:password form guarding the app (/api/health stays open).
RUNAI_BASIC_AUTH=
# Maximum number of steps per H agent session (defaults to 60).
RUNAI_H_MAX_STEPS=
# Maximum wall-clock time per H agent session, in seconds (defaults to 900).
RUNAI_H_MAX_TIME_S=
# Directory where H agent traces are written (defaults to ./traces).
RUNAI_TRACES_DIR=
