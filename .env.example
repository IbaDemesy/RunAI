# H Company Agents API key (h/web-surfer-pro sessions and Holo chat).
HAI_API_KEY=
# Optional second H organization key, pooled with HAI_API_KEY for more concurrent sessions.
HAI_API_KEY_2=
# Gladia speech-to-text key (live voice input).
GLADIA_API_KEY=
# Optional backup Gladia key.
GLADIA_API_KEY_2=
# Linkup search key (race lookup and start-URL precomputation).
LINKUP_API_KEY=
# Optional backup Linkup key.
LINKUP_API_KEY_2=
# App mode: live, demo or replay (defaults to live).
RUNAI_MODE=
# Set to 1 when the app is publicly reachable; live mode then requires RUNAI_BASIC_AUTH.
RUNAI_PUBLIC=
# HTTP Basic credentials in user:password form guarding the app (/api/health stays open).
RUNAI_BASIC_AUTH=
# Maximum number of steps per H agent session (defaults to 60).
RUNAI_H_MAX_STEPS=
# Maximum wall-clock time per H agent session, in seconds (defaults to 900).
RUNAI_H_MAX_TIME_S=
# Directory where H agent traces are written (defaults to ./traces).
RUNAI_TRACES_DIR=

# Other optional settings (names only):
# Extra H accounts: HAI_API_KEY_3, HAI_API_KEY_4, etc. (no gaps).
# Replay: RUNAI_REPLAY_TRACE, RUNAI_DEMO_DELAY. Legacy demo selector: RUNAI_DEMO.
# Server binding: RUNAI_APP_HOST, RUNAI_APP_PORT. CSP: RUNAI_CSP_ENFORCE.
# Agent settings: RUNAI_H_AGENT, RUNAI_H_MAX_CONCURRENCY.
# Framing: RUNAI_FRAMING_LLM, RUNAI_FRAMING_MODEL.
# Human question timeout: RUNAI_QUESTION_TIMEOUT_S.
# Logs: RUNAI_LOG_LEVEL (INFO), RUNAI_LOG_FORMAT (json or text). H retries: RUNAI_H_MAX_ATTEMPTS (default 2); H request overrides as a JSON object: RUNAI_H_OVERRIDES.
# Content-Security-Policy: report-only by default; RUNAI_CSP_ENFORCE=1 enforces it (render.yaml ships 0, switch it on after checking the browser console).
# H key blocked after insufficient_credit for RUNAI_H_CREDIT_BLOCK_S (default 900); terminal missions leave memory after RUNAI_MISSION_TTL_S (default 86400, kept on disk).
# Logistics cache: RUNAI_LOGISTICS_CACHE.
# PDF browser executable: RUNAI_CHROME (or CHROME_PATH).

# Optional: disable H answer schemas and keep the legacy text-report path.
# RUNAI_H_TYPED_ANSWERS=0
